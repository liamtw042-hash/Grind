rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: readable by all authenticated users, writable only by owner
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Sessions: owner only
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Battles: participants only
    match /battles/{battleId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.challenger ||
         request.auth.uid == resource.data.challenged);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.challenger;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.challenger ||
         request.auth.uid == resource.data.challenged);
    }

    // ProveIt challenges: participants only
    match /proveit/{challengeId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.from ||
         request.auth.uid == resource.data.to);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.from;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.from ||
         request.auth.uid == resource.data.to);
    }
  }
}
